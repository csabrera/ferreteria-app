// Ferretería HCO — esquema de datos
// Ver plan-ferreteria.md §4 para diagrama relacional y reglas de integridad

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════════════════════

enum Role {
  ADMIN
  VENDOR
}

enum DocumentType {
  DNI // 8 dígitos numéricos
  CE  // Carné de Extranjería: 9-12 alfanuméricos
  PAS // Pasaporte: 6-12 alfanuméricos
}

enum Gender {
  M // Masculino
  F // Femenino
  O // Otro
}

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  SALE_VOID
}

enum AdjustmentReason {
  ROTURA
  MERMA
  ROBO
  ERROR_CONTEO
  OTRO
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE
  INCOME
  EXPENSE
  WITHDRAWAL
  DEPOSIT
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

// ════════════════════════════════════════════════════════════
// CORE — Tiendas, Usuarios, Configuración
// ════════════════════════════════════════════════════════════

model Store {
  id        String   @id @default(cuid())
  code      String   @unique // HCO-001, HCO-002, ... siempre UPPERCASE
  name      String
  address   String?
  phone     String // celular Perú obligatorio: 9 dígitos empezando con 9
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  stocks             Stock[]
  cashRegisters      CashRegister[]
  sales              Sale[]
  inventoryMovements InventoryMovement[]
  transfersOut       Transfer[]          @relation("TransferFromStore")
  transfersIn        Transfer[]          @relation("TransferToStore")
}

model User {
  id             String       @id @default(cuid())
  documentType   DocumentType
  documentNumber String
  passwordHash   String

  // Datos personales (todos en lowercase en BD; display en UPPERCASE)
  lastNameP String // apellido paterno
  lastNameM String // apellido materno
  firstName String // nombres

  phone     String // celular Perú: 9 dígitos empezando con 9
  email     String? @unique // único cuando no es null
  birthDate DateTime
  address   String
  gender    Gender

  role     Role
  storeId  String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store              Store?              @relation(fields: [storeId], references: [id])
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  sales              Sale[]
  voidedSales        Sale[]              @relation("VoidedByUser")
  inventoryMovements InventoryMovement[]
  transfersCreated   Transfer[]          @relation("TransferCreatedBy")
  transfersReceived  Transfer[]          @relation("TransferReceivedBy")
  auditLogs          AuditLog[]
  settingsUpdates    AppSettings[]

  @@unique([documentType, documentNumber])
  @@index([storeId, role])
  @@index([documentNumber])
}

model AppSettings {
  id Int @id @default(1)

  // — Identidad —
  businessName String  @default("Ferretería HCO")
  ruc          String?
  logoUrl      String?
  slogan       String?

  // — Apariencia —
  accentColor     String  @default("#2563eb")
  darkModeDefault Boolean @default(false)
  faviconUrl      String?

  // — Ticket —
  ticketHeader     String? @db.Text
  ticketFooter     String? @db.Text
  thankYouMessage  String  @default("¡Gracias por su compra!")
  showLogoOnTicket Boolean @default(true)

  // — Operación —
  currency        String  @default("PEN")
  currencySymbol  String  @default("S/")
  igvPercent      Decimal @default(18.00) @db.Decimal(5, 2)
  timezone        String  @default("America/Lima")
  defaultMinStock Decimal @default(5) @db.Decimal(14, 3)

  // — Metadata —
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
}

// ════════════════════════════════════════════════════════════
// PROVEEDORES
// ════════════════════════════════════════════════════════════

model Supplier {
  id           String  @id @default(cuid())
  ruc          String  @unique // 11 dígitos, formato Perú
  businessName String  // razón social (lowercase BD, UPPERCASE display)
  contactName  String? // nombre del contacto comercial
  phone        String  // celular Perú obligatorio
  email        String? // opcional
  address      String
  notes        String? @db.Text // observaciones internas
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryMovements InventoryMovement[]

  @@index([businessName])
}

// ════════════════════════════════════════════════════════════
// CATÁLOGO
// ════════════════════════════════════════════════════════════

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String?
  imageUrl String?
  isActive Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  logoUrl  String?
  isActive Boolean @default(true)

  products Product[]
}

model Unit {
  id     String @id @default(cuid())
  code   String @unique // UN, CJ, MT, KG, LT, SC
  name   String
  symbol String

  productsAsBase Product[]
  productUnits   ProductUnit[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  barcode     String?  @unique
  name        String
  description String?  @db.Text
  categoryId  String
  brandId     String?
  baseUnitId  String
  images      String[] @default([])
  costPrice   Decimal  @default(0) @db.Decimal(12, 2)
  salePrice   Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id])
  brand              Brand?              @relation(fields: [brandId], references: [id])
  baseUnit           Unit                @relation(fields: [baseUnitId], references: [id])
  productUnits       ProductUnit[]
  stocks             Stock[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  transferItems      TransferItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([name])
  @@index([isActive])
}

model ProductUnit {
  id        String  @id @default(cuid())
  productId String
  unitId    String
  factor    Decimal @db.Decimal(14, 4) // Cuántas unidades base por presentación (CJ=24)
  salePrice Decimal @db.Decimal(12, 2)
  barcode   String? @unique
  isDefault Boolean @default(false)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      Unit       @relation(fields: [unitId], references: [id])
  saleItems SaleItem[]

  @@unique([productId, unitId])
}

// ════════════════════════════════════════════════════════════
// INVENTARIO
// ════════════════════════════════════════════════════════════

model Stock {
  id        String   @id @default(cuid())
  productId String
  storeId   String
  quantity  Decimal  @default(0) @db.Decimal(14, 3)
  minStock  Decimal  @default(0) @db.Decimal(14, 3)
  maxStock  Decimal? @db.Decimal(14, 3)
  version   Int      @default(0) // Lock optimista
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@index([storeId])
}

model InventoryMovement {
  id                String            @id @default(cuid())
  productId         String
  storeId           String
  type              MovementType
  quantity          Decimal           @db.Decimal(14, 3) // siempre positivo
  unitCost          Decimal?          @db.Decimal(12, 2)
  previousStock     Decimal           @db.Decimal(14, 3)
  newStock          Decimal           @db.Decimal(14, 3)
  reference         String? // # orden compra, # ajuste, etc.
  reason            AdjustmentReason?
  reasonNote        String?
  supplierId        String? // solo aplica a movimientos tipo ENTRY
  relatedTransferId String?
  relatedSaleId     String?
  userId            String
  createdAt         DateTime          @default(now())

  product         Product   @relation(fields: [productId], references: [id])
  store           Store     @relation(fields: [storeId], references: [id])
  user            User      @relation(fields: [userId], references: [id])
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  relatedTransfer Transfer? @relation(fields: [relatedTransferId], references: [id])
  relatedSale     Sale?     @relation(fields: [relatedSaleId], references: [id])

  @@index([productId, storeId, createdAt(sort: Desc)])
  @@index([type, createdAt])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([supplierId])
}

model Transfer {
  id           String         @id @default(cuid())
  fromStoreId  String
  toStoreId    String
  status       TransferStatus @default(DRAFT)
  notes        String?
  createdById  String
  receivedById String?
  createdAt    DateTime       @default(now())
  receivedAt   DateTime?

  fromStore  Store               @relation("TransferFromStore", fields: [fromStoreId], references: [id])
  toStore    Store               @relation("TransferToStore", fields: [toStoreId], references: [id])
  createdBy  User                @relation("TransferCreatedBy", fields: [createdById], references: [id])
  receivedBy User?               @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  items      TransferItem[]
  movements  InventoryMovement[]

  @@index([fromStoreId, status])
  @@index([toStoreId, status])
}

model TransferItem {
  id         String  @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(14, 3)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

// ════════════════════════════════════════════════════════════
// CAJA
// ════════════════════════════════════════════════════════════

model CashRegister {
  id       String  @id @default(cuid())
  storeId  String
  name     String  // "Caja 1"
  isActive Boolean @default(true)

  store    Store         @relation(fields: [storeId], references: [id])
  sessions CashSession[]

  @@index([storeId])
}

model CashSession {
  id             String            @id @default(cuid())
  cashRegisterId String
  userId         String
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openingAmount  Decimal           @db.Decimal(12, 2)
  expectedAmount Decimal           @default(0) @db.Decimal(12, 2)
  countedAmount  Decimal?          @db.Decimal(12, 2)
  difference     Decimal?          @db.Decimal(12, 2)
  status         CashSessionStatus @default(OPEN)
  notes          String?

  cashRegister CashRegister   @relation(fields: [cashRegisterId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  movements    CashMovement[]
  sales        Sale[]

  // NOTA: unicidad de "una sola OPEN por caja" se garantiza en la Server Action openCashSession
  @@index([cashRegisterId, status])
  @@index([userId, status])
}

model CashMovement {
  id              String           @id @default(cuid())
  cashSessionId   String
  type            CashMovementType
  amount          Decimal          @db.Decimal(12, 2) // signo según type
  paymentMethodId String?
  description     String?
  relatedSaleId   String?
  userId          String
  createdAt       DateTime         @default(now())

  cashSession   CashSession    @relation(fields: [cashSessionId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  relatedSale   Sale?          @relation(fields: [relatedSaleId], references: [id])

  @@index([cashSessionId])
  @@index([createdAt])
}

model PaymentMethod {
  id                String  @id @default(cuid())
  code              String  @unique // CASH, YAPE, PLIN, TRANSFER
  name              String
  requiresReference Boolean @default(false)
  affectsCash       Boolean @default(false)
  isActive          Boolean @default(true)

  salePayments  SalePayment[]
  cashMovements CashMovement[]
}

// ════════════════════════════════════════════════════════════
// VENTAS
// ════════════════════════════════════════════════════════════

model Sale {
  id            String     @id @default(cuid())
  code          String     @unique // V-HCO-001-000123
  storeId       String
  cashSessionId String
  userId        String
  subtotal      Decimal    @db.Decimal(12, 2)
  discount      Decimal    @default(0) @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)
  status        SaleStatus @default(COMPLETED)
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  notes         String?
  createdAt     DateTime   @default(now())

  store              Store               @relation(fields: [storeId], references: [id])
  cashSession        CashSession         @relation(fields: [cashSessionId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  voidedBy           User?               @relation("VoidedByUser", fields: [voidedById], references: [id])
  items              SaleItem[]
  payments           SalePayment[]
  cashMovements      CashMovement[]
  inventoryMovements InventoryMovement[]

  @@index([storeId, createdAt(sort: Desc)])
  @@index([cashSessionId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

model SaleItem {
  id            String  @id @default(cuid())
  saleId        String
  productId     String
  productUnitId String
  quantity      Decimal @db.Decimal(14, 3)
  unitPrice     Decimal @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(12, 2)

  sale        Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id              String  @id @default(cuid())
  saleId          String
  paymentMethodId String
  amount          Decimal @db.Decimal(12, 2)
  reference       String? // # operación Yape/Plin/Transferencia

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([saleId])
}

// ════════════════════════════════════════════════════════════
// AUDITORÍA
// ════════════════════════════════════════════════════════════

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // PRODUCT_UPDATE, SALE_VOID, STOCK_ADJUSTMENT, SETTINGS_UPDATE, etc.
  entity    String // Product, Sale, Stock, AppSettings, User
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

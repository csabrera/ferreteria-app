# Variables de entorno para PRODUCCIÓN (Railway)
# NO comitear este archivo lleno — solo es ejemplo.
# Las reales se configuran en el dashboard de Railway.

# Conexión a la BD (Railway la provee automáticamente cuando agregás Postgres)
DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB?schema=public

# Secreto para firmar JWTs de NextAuth. GENERAR UNO NUEVO con:
#   openssl rand -base64 32
# o en PowerShell:
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
AUTH_SECRET=cambiar-por-uno-aleatorio-de-32+-bytes

# URL pública del deploy. Railway la conoce vía RAILWAY_PUBLIC_DOMAIN.
# Si tenés dominio custom, ponerlo acá completo con https.
AUTH_URL=https://ferreteria-hco.up.railway.app

# Storage de imágenes. En F1 usar "local" (con volume montado en /app/public/uploads).
# En F2 cambiar a "cloudinary" / "r2" / "uploadthing".
STORAGE_PROVIDER=local

# Node env (Railway suele setearlo, pero por las dudas)
NODE_ENV=production

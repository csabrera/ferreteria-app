# ════════════════════════════════════════════
# BASE DE DATOS
# ════════════════════════════════════════════
# URL de conexión PostgreSQL. Para docker-compose local usar el valor de abajo.
DATABASE_URL="postgresql://ferreteria:ferreteria_dev@localhost:5432/ferreteria_hco?schema=public"

# ════════════════════════════════════════════
# AUTENTICACIÓN (NextAuth v5)
# ════════════════════════════════════════════
# Generar con: openssl rand -base64 32
# (En Windows PowerShell: [Convert]::ToBase64String((1..32 | %{Get-Random -Max 256})))
AUTH_SECRET="cambia-esto-en-produccion"

# URL pública de la app. En dev: http://localhost:3000
AUTH_URL="http://localhost:3000"

# ════════════════════════════════════════════
# ALMACENAMIENTO DE IMÁGENES
# ════════════════════════════════════════════
# F1: local | F2: cloudinary | r2 | uploadthing
STORAGE_PROVIDER="local"

# ════════════════════════════════════════════
# AMBIENTE
# ════════════════════════════════════════════
NODE_ENV="development"
